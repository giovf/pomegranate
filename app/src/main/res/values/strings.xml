    <string name="onboarding_purpose_title">See where your photos live</string>
    <string name="onboarding_purpose_body">Pomegranate shows you, for every photo and video, whether it is on this phone, in Google Photos, or both. Then it pulls everything that only exists in the cloud into a folder you choose, proves each copy, and lets you leave Google Photos cleanly.</string>
    <string name="onboarding_privacy_title">Your data stays yours</string>
    <string name="onboarding_privacy_body">Everything happens on this phone. The only servers ever contacted are Google\'s sign-in and Photos Picker, and only when you ask.</string>
    <string name="privacy_promise_tokens_wiped">• Your Google sign-in is revoked and wiped when you disconnect</string>
    <string name="onboarding_states_title">Three states, one colour each</string>
    <string name="onboarding_states_body">Every item is shown with the same colour and icon for its state, so you always know where it lives.</string>
    <string name="onboarding_destination_title">Where should pulled photos go?</string>
    <string name="onboarding_destination_body">Choose a folder. Pomegranate creates Pomegranate/YYYY/YYYY-MM inside it and never touches anything else.</string>
    <string name="destination_none">No folder chosen yet</string>
    <string name="destination_choose">Choose folder</string>
    <string name="destination_change">Change folder</string>
    <string name="destination_removable_hint">Removable storage: ideal for large libraries</string>
    <string name="destination_sd_guidance">Tip: an SD card or USB drive keeps your library off the phone\'s internal storage. In the picker, open the menu to switch storage.</string>
    <string name="storage_internal">Internal storage</string>
    <string name="storage_removable">SD card or USB</string>
    <string name="backup_warning_title">This folder may be backed up</string>
    <string name="backup_warning_body">Google Photos often backs up DCIM, Pictures, Download and Screenshots. Files pulled here could be uploaded straight back. Choose a new folder such as Pomegranate, or exclude this one in Google Photos backup settings.</string>
    <string name="backup_warning_change">Choose another</string>
    <string name="backup_warning_keep">Keep it</string>
    <string name="destination_error_title">Folder not usable</string>
    <string name="destination_error_not_persistable">Pomegranate could not keep access to that folder. Please pick a folder on this phone or its SD card.</string>
    <string name="destination_error_revoked">Access to the previously chosen folder was lost. Please choose it again.</string>
    <string name="connection_title">Google Photos</string>
    <string name="connection_body">Pomegranate asks Google only for permission to show you photos you pick in Google\'s own picker. It cannot see anything you do not select, and it never changes or deletes anything in Google Photos.</string>
    <string name="connection_not_configured">This build has no Google OAuth client id. Add pomegranate.oauthClientId to local.properties and rebuild.</string>
