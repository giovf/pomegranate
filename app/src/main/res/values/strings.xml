    <string name="fidelity_notice_title">What you get from Google</string>
    <string name="fidelity_notice_body">Google\'s picker hands out photos without their location data and videos as re-encoded copies, not the originals you uploaded. Every pulled file is labelled accordingly. Full-fidelity export via Google Takeout is planned for a later version.</string>
    <string name="fidelity_notice_dont_show">Don\'t show this again</string>
