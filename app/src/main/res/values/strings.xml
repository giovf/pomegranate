    <string name="permission_title">Access your photos and videos</string>
    <string name="permission_body">Pomegranate reads the photos and videos on this phone so it can show you which ones also exist in Google Photos, and which exist only there.</string>
    <string name="permission_body_retry">Without access to your photos and videos, Pomegranate cannot tell what is already on this phone. Please allow access to continue.</string>
