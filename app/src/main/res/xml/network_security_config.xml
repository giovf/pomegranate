<?xml version="1.0" encoding="utf-8"?>
<!-- Only HTTPS, only the system trust store. No user-added CAs, no pins
     (Google rotates certificates), no cleartext anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
