<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (API 30) counterpart of data_extraction_rules.xml: exclude
     everything from Auto Backup. Nothing this app stores may leave the device. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
