{
  "name": "Pomegranate (Android / Kotlin)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "vscode",

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Persistent named volumes keep state across container rebuilds.
  // All are PER-PROJECT (prefixed with the workspace folder name), so two
  // projects created from this template never share state:
  // - claude-config:  ~/.claude (auth + session history + custom commands).
  //                   You run /login once per project; it survives rebuilds.
  // - node-modules:   keeps installs fast, off slow bind-mounts
  // - shell-history:  preserves zsh history
  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-shell-history,target=/commandhistory,type=volume"
  ],

  // Native Android app: no dev server, nothing to forward. Testing happens on
  // a physical phone (sideloaded debug APK, or adb over Wi-Fi from the host).
  "forwardPorts": [],

  // Runs once after the container is first created (and after every rebuild).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        // Android / Kotlin
        "mathiasfrohlich.Kotlin",
        "vscjava.vscode-gradle",
        "redhat.vscode-xml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "files.exclude": { "**/.gradle": true, "**/build": true }
      }
    }
  }
}
